<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Smart Monitoring Sungai Code — Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <style>
    :root{ --ok:#16a34a; --warn:#f59e0b; --bad:#dc2626; --muted:#64748b; }
    body{ background:#f8fafc; }
    .kpi-card{ border:1px solid #e5e7eb; border-radius:1rem; background:#fff; }
    .kpi-value{ font-size:1.6rem; font-weight:700; }
    .kpi-trend{ font-size:.9rem; color:var(--muted); }
    .badge-dot{ width:.6rem; height:.6rem; display:inline-block; border-radius:50%; margin-right:.4rem; }
    .status-ok{ background:var(--ok); } .status-warn{ background:var(--warn); } .status-bad{ background:var(--bad); }
    .card{ border-radius:1rem; }
    .chart-wrap{ height:320px; }
    .table thead th{ background:#f1f5f9; }
    .small-muted{ color:#64748b; font-size:.9rem;}
    .legend-box{ width:12px; height:12px; display:inline-block; border-radius:2px; margin-right:6px; }
    .footer{ color:#94a3b8; }
    .map-iframe{ border:0; width:100%; height:260px; border-radius:0.75rem; }
  </style>
</head>
<body>

<nav class="navbar navbar-expand-lg bg-white border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand fw-semibold" href="#">Smart Monitoring — Sungai Code</a>
    <div class="d-flex gap-2">
      <input type="date" class="form-control form-control-sm" value="2025-10-01">
      <input type="date" class="form-control form-control-sm" value="2025-10-07">
      <button class="btn btn-sm btn-primary">Terapkan</button>
    </div>
  </div>
</nav>

<main class="container my-4">

  <!-- KPI quick stats -->
  <div class="row g-3">
    <div class="col-6 col-md-4 col-lg-2">
      <div class="p-3 kpi-card h-100">
        <div class="small-muted">pH</div>
        <div class="d-flex align-items-baseline justify-content-between">
          <div class="kpi-value" id="kpi-ph">7.2</div>
          <span class="badge bg-light text-dark">6–9</span>
        </div>
        <div class="kpi-trend"><span class="badge-dot status-ok"></span>Stabil</div>
      </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
      <div class="p-3 kpi-card h-100">
        <div class="small-muted">DO</div>
        <div class="d-flex align-items-baseline justify-content-between">
          <div class="kpi-value" id="kpi-do">6.1</div>
          <span class="badge bg-light text-dark">&ge; 4 mg/L</span>
        </div>
        <div class="kpi-trend"><span class="badge-dot status-ok"></span>Baik</div>
      </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
      <div class="p-3 kpi-card h-100">
        <div class="small-muted">TDS</div>
        <div class="d-flex align-items-baseline justify-content-between">
          <div class="kpi-value" id="kpi-tds">420</div>
          <span class="badge bg-light text-dark">&le; 1000 mg/L</span>
        </div>
        <div class="kpi-trend"><span class="badge-dot status-ok"></span>Aman</div>
      </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
      <div class="p-3 kpi-card h-100">
        <div class="small-muted">Kekeruhan (NTU)</div>
        <div class="d-flex align-items-baseline justify-content-between">
          <div class="kpi-value" id="kpi-turb">18</div>
          <span class="badge bg-light text-dark">&le; 25</span>
        </div>
        <div class="kpi-trend"><span class="badge-dot status-warn"></span>Cenderung naik</div>
      </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
      <div class="p-3 kpi-card h-100">
        <div class="small-muted">Suhu (°C)</div>
        <div class="d-flex align-items-baseline justify-content-between">
          <div class="kpi-value" id="kpi-temp">28.4</div>
          <span class="badge bg-light text-dark">–</span>
        </div>
        <div class="kpi-trend"><span class="badge-dot status-ok"></span>Normal</div>
      </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
      <div class="p-3 kpi-card h-100">
        <div class="small-muted">Konduktivitas (µS/cm)</div>
        <div class="d-flex align-items-baseline justify-content-between">
          <div class="kpi-value" id="kpi-cond">620</div>
          <span class="badge bg-light text-dark">Info</span>
        </div>
        <div class="kpi-trend"><span class="badge-dot status-ok"></span>Stabil</div>
      </div>
    </div>
  </div>

  <div class="row g-3 mt-1">
    <!-- Main time-series chart -->
    <div class="col-lg-8">
      <div class="card">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="card-title mb-0">Tren Parameter (24 jam)</h5>
            <div class="small-muted">
              <span class="legend-box" style="background:#2563eb"></span>pH
              <span class="legend-box" style="background:#059669; margin-left:10px"></span>DO
              <span class="legend-box" style="background:#f59e0b; margin-left:10px"></span>TDS
              <span class="legend-box" style="background:#ef4444; margin-left:10px"></span>Kekeruhan
              <span class="legend-box" style="background:#6b7280; margin-left:10px"></span>Suhu
            </div>
          </div>
          <div class="chart-wrap">
            <canvas id="lineChart"></canvas>
          </div>
          <div class="small-muted mt-2">Garis putus-putus menunjukkan batas baku mutu Kelas II (PP 22/2021): pH 6–9, DO ≥ 4 mg/L, TDS ≤ 1000 mg/L, Kekeruhan ≤ 25 NTU.</div>
        </div>
      </div>
    </div>

    <!-- Alerts / recent + MAP -->
    <div class="col-lg-4">
      <div class="card mb-3">
        <div class="card-body">
          <h5 class="card-title">Notifikasi & Peringatan</h5>
          <ul class="list-group list-group-flush">
            <li class="list-group-item d-flex justify-content-between align-items-start">
              <div><span class="badge-dot status-warn"></span><strong>Kekeruhan</strong> naik di Pos 2 (KM 14)</div>
              <span class="badge text-bg-warning">Moderate</span>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-start">
              <div><span class="badge-dot status-bad"></span><strong>pH</strong> turun (5.8) di Pos 3 (KM 22)</div>
              <span class="badge text-bg-danger">Alert</span>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-start">
              <div><span class="badge-dot status-ok"></span>Semua sensor online</div>
              <span class="badge text-bg-success">OK</span>
            </li>
          </ul>
        </div>
      </div>

      <div class="card">
        <div class="card-body">
          <h6 class="card-title mb-1">Peta Lokasi</h6>
          <div class="small-muted mb-2">Titik sensor di Sungai Code — (embed Google Maps). Jika iframe diblokir, gunakan tombol “Buka Peta”.</div>
          <!-- Embed google maps (query: Code River Yogyakarta) -->
          <iframe class="map-iframe"
            src="https://www.google.com/maps?q=Code%20River%20Yogyakarta&output=embed"
            loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
          <div class="d-grid mt-2">
            <a class="btn btn-outline-primary btn-sm" target="_blank"
               href="https://maps.app.goo.gl/GcJEZiAqhyihRaHZ9">Buka Peta Google Maps (Sungai Code)</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Table sensors -->
  <div class="card mt-3">
    <div class="card-body">
      <h5 class="card-title">Ringkasan Titik Sensor</h5>
      <div class="table-responsive">
        <table class="table table-bordered table-sm align-middle">
          <thead>
            <tr>
              <th>Pos</th><th>Koordinat</th><th>pH</th><th>DO (mg/L)</th><th>TDS (mg/L)</th><th>NTU</th><th>Suhu (°C)</th><th>Status</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>Pos 1 (KM 5)</td><td>-7.776, 110.367</td><td>7.4</td><td>6.8</td><td>410</td><td>14</td><td>28.0</td><td><span class="badge text-bg-success">OK</span></td></tr>
            <tr><td>Pos 2 (KM 14)</td><td>-7.770, 110.374</td><td>7.1</td><td>5.6</td><td>460</td><td>23</td><td>28.5</td><td><span class="badge text-bg-warning">Perlu Pantau</span></td></tr>
            <tr><td>Pos 3 (KM 22)</td><td>-7.763, 110.382</td><td>5.8</td><td>4.4</td><td>520</td><td>27</td><td>29.2</td><td><span class="badge text-bg-danger">Alert</span></td></tr>
          </tbody>
        </table>
      </div>
      <div class="small-muted">Catatan: data di atas adalah <em>dummy</em> untuk kebutuhan desain antarmuka.</div>
    </div>
  </div>

  <!-- Secondary charts -->
  <div class="row g-3 mt-1">
    <div class="col-lg-6">
      <div class="card">
        <div class="card-body">
          <h6 class="card-title">Rata-rata Harian per Parameter</h6>
          <div class="chart-wrap">
            <canvas id="barChart"></canvas>
          </div>
        </div>
      </div>
    </div>
    <div class="col-lg-6">
      <div class="card">
        <div class="card-body">
          <h6 class="card-title">Status Kepatuhan Baku Mutu</h6>
          <div class="chart-wrap">
            <canvas id="doughnutChart"></canvas>
          </div>
          <div class="small-muted mt-2">Kepatuhan dihitung dari proporsi titik waktu yang memenuhi ambang: pH 6–9, DO ≥ 4 mg/L, TDS ≤ 1000 mg/L, NTU ≤ 25.</div>
        </div>
      </div>
    </div>
  </div>

  <p class="footer text-center mt-4 mb-0">© Dashboard Wireframe — Smart Monitoring Sungai Code (Dummy)</p>
</main>

<script>
// ===== Dummy time labels (per 2 jam, 24 jam) =====
const labels = Array.from({length:12}, (_,i)=> (i*2).toString().padStart(2,'0') + ':00');

// ===== Dummy data (realistis) =====
const dataPh   = [7.2,7.1,7.0,6.9,6.8,7.0,7.3,7.4,7.2,7.1,7.0,6.7];
const dataDo   = [6.5,6.3,6.1,5.8,5.6,5.4,5.2,5.0,4.8,4.6,4.4,4.2];
const dataTds  = [380,390,400,410,430,450,470,480,490,510,520,540];
const dataTurb = [10,12,13,14,16,18,19,21,22,23,24,27];
const dataTmp  = [27.5,27.3,27.2,27.1,27.0,27.2,27.8,28.3,28.7,28.9,29.1,29.3];

// ===== Line Chart =====
const ctx = document.getElementById('lineChart');
new Chart(ctx, {
  type:'line',
  data:{
    labels,
    datasets:[
      {label:'pH', data:dataPh, tension:.3, borderWidth:2, borderColor:'#2563eb', pointRadius:0},
      {label:'DO', data:dataDo, tension:.3, borderWidth:2, borderColor:'#059669', pointRadius:0, yAxisID:'y-do'},
      {label:'TDS', data:dataTds, tension:.3, borderWidth:2, borderColor:'#f59e0b', pointRadius:0, yAxisID:'y-tds'},
      {label:'NTU', data:dataTurb, tension:.3, borderWidth:2, borderColor:'#ef4444', pointRadius:0, yAxisID:'y-ntu'},
      {label:'Suhu', data:dataTmp, tension:.3, borderWidth:2, borderColor:'#6b7280', pointRadius:0, yAxisID:'y-temp'}
    ]
  },
  options:{
    interaction:{mode:'index', intersect:false},
    responsive:true,
    plugins:{ legend:{display:false} },
    scales:{
      y:{display:false},
      'y-do':{type:'linear', display:false, position:'left'},
      'y-tds':{type:'linear', display:false, position:'right'},
      'y-ntu':{type:'linear', display:false, position:'right'},
      'y-temp':{type:'linear', display:false, position:'right'}
    }
  }
});

// ===== Bar averages =====
new Chart(document.getElementById('barChart'),{
  type:'bar',
  data:{ labels:['pH','DO','TDS','NTU','Suhu'], datasets:[{ label:'Rata-rata Harian', data:[7.1,5.3,468,19,28.4] }] },
  options:{ plugins:{legend:{display:false}}, scales:{y:{beginAtZero:true}} }
});

// ===== Doughnut compliance =====
new Chart(document.getElementById('doughnutChart'),{
  type:'doughnut',
  data:{ labels:['Memenuhi','Peringatan','Pelanggaran'], datasets:[{ data:[72,18,10] }] },
  options:{ plugins:{legend:{position:'bottom'}} }
});
</script>

</body>
</html>

